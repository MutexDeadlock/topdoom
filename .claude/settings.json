{
  "permissions": {
    "allow": [
      "WebFetch(domain:doomwiki.org)"
    ],
    "deny": [
      "Edit(TODO)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/conventions.mjs"
          }
        ]
      }
    ]
  }
}
